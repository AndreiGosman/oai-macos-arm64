From 6bf35e1075a7d3fa174ed801a931558f8fc24065 Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Fri, 2 Oct 2026 13:28:20 +0300
Subject: [PATCH] build: link pkg-config libraries by full path

pkg_check_modules() fills <prefix>_LIBRARIES with bare library names
("config", "ssl crypto", "zmq") and the search directories separately in
<prefix>_LIBRARY_DIRS. The targets only used the names, which works on
Linux because the distribution libraries live in a default linker
search path, and fails on any prefix the linker does not search on its
own, Homebrew on Darwin for one:

  ld: library 'config' not found

<prefix>_LINK_LIBRARIES carries the same libraries as full paths, which
is what target_link_libraries() wants. Use it for libconfig, OpenSSL and
ZeroMQ.
---
 CMakeLists.txt                    | 4 ++--
 openair3/NAS/TOOLS/CMakeLists.txt | 6 +++---
 radio/zmq/CMakeLists.txt          | 6 +++---
 3 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c19268e..97da799 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -627,7 +627,7 @@ target_link_libraries(CONFIG_LIB PRIVATE config_internals dl UTIL)
 pkg_check_modules(libconfig REQUIRED libconfig)
 add_library(params_libconfig MODULE ${CONFIG_ROOTDIR}/libconfig/config_libconfig.c)
 target_include_directories(params_libconfig PRIVATE ${libconfig_INCLUDE_DIRS})
-target_link_libraries(params_libconfig PRIVATE config_internals ${libconfig_LIBRARIES})
+target_link_libraries(params_libconfig PRIVATE config_internals ${libconfig_LINK_LIBRARIES})
 
 # shared library loader
 add_library(shlib_loader OBJECT common/utils/load_module_shlib.c)
@@ -762,7 +762,7 @@ set(SECURITY_SRC
 pkg_check_modules(OpenSSL openssl REQUIRED)
 add_library(SECURITY ${SECURITY_SRC} $<TARGET_OBJECTS:ds>)
 target_include_directories(SECURITY PRIVATE ${OPENAIR_DIR}/common/utils/ds/)
-target_link_libraries(SECURITY PRIVATE ${OpenSSL_LIBRARIES})
+target_link_libraries(SECURITY PRIVATE ${OpenSSL_LINK_LIBRARIES})
 
 # Physical Channel Procedures Scheduling
 ################################"
diff --git a/openair3/NAS/TOOLS/CMakeLists.txt b/openair3/NAS/TOOLS/CMakeLists.txt
index 850e949..962709a 100755
--- a/openair3/NAS/TOOLS/CMakeLists.txt
+++ b/openair3/NAS/TOOLS/CMakeLists.txt
@@ -20,14 +20,14 @@ target_link_libraries(conf2uedata_lib PUBLIC log_headers)
 add_executable(conf2uedata conf2uedata.c)
 target_link_libraries(conf2uedata PRIVATE conf2uedata_lib)
 set_target_properties(conf2uedata PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
-target_link_libraries(conf2uedata PRIVATE LOG minimal_lib ${libconfig_LIBRARIES})
+target_link_libraries(conf2uedata PRIVATE LOG minimal_lib ${libconfig_LINK_LIBRARIES})
 
 add_executable(usim usim.c)
 target_link_libraries(usim PRIVATE conf2uedata_lib)
 set_target_properties(usim PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
-target_link_libraries(usim PRIVATE LOG minimal_lib ${libconfig_LIBRARIES})
+target_link_libraries(usim PRIVATE LOG minimal_lib ${libconfig_LINK_LIBRARIES})
 
 add_executable(nvram nvram.c)
 target_link_libraries(nvram PRIVATE conf2uedata_lib)
 set_target_properties(nvram PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
-target_link_libraries(nvram PRIVATE LOG minimal_lib ${libconfig_LIBRARIES})
+target_link_libraries(nvram PRIVATE LOG minimal_lib ${libconfig_LINK_LIBRARIES})
diff --git a/radio/zmq/CMakeLists.txt b/radio/zmq/CMakeLists.txt
index ce23cb5..550ad1c 100644
--- a/radio/zmq/CMakeLists.txt
+++ b/radio/zmq/CMakeLists.txt
@@ -4,16 +4,16 @@ pkg_check_modules(zmq REQUIRED libzmq)
 add_library(ring_buffer ring_buffer.cpp)
 add_library(zmq_imported zmq_imported.cpp)
 target_include_directories(zmq_imported PUBLIC ./)
-target_link_libraries(zmq_imported PUBLIC ${zmq_LIBRARIES} log_headers)
+target_link_libraries(zmq_imported PUBLIC ${zmq_LINK_LIBRARIES} log_headers)
 
 target_include_directories(ring_buffer PUBLIC ./)
 add_library(oai_zmqdevif SHARED zmq_radio.cpp)
-target_link_libraries(oai_zmqdevif PUBLIC ${zmq_LIBRARIES} ring_buffer log_headers zmq_imported)
+target_link_libraries(oai_zmqdevif PUBLIC ${zmq_LINK_LIBRARIES} ring_buffer log_headers zmq_imported)
 target_include_directories(oai_zmqdevif PUBLIC ${zmq_INCLUDE_DIRS})
 set_target_properties(oai_zmqdevif PROPERTIES LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
 
 add_library(zmq_radio_static STATIC zmq_radio.cpp)
-target_link_libraries(zmq_radio_static PUBLIC ${zmq_LIBRARIES} ring_buffer log_headers zmq_imported)
+target_link_libraries(zmq_radio_static PUBLIC ${zmq_LINK_LIBRARIES} ring_buffer log_headers zmq_imported)
 target_include_directories(zmq_radio_static PUBLIC ${zmq_INCLUDE_DIRS})
 
 if (ENABLE_TESTS)
