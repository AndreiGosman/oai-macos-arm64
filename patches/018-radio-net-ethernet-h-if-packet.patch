+++ b/radio/ETHERNET/eth_udp.c
@@ -10,7 +10,9 @@
 #define _GNU_SOURCE
 
 #include <arpa/inet.h>
+#ifdef __linux__
 #include <linux/if_packet.h>
+#endif
 #include <stdio.h>
 #include <string.h>
 #include <stdlib.h>
