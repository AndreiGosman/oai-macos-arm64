diff --git a/radio/ETHERNET/ethernet_lib.h b/radio/ETHERNET/ethernet_lib.h
index 6ba0a86..1e9493a 100644
--- a/radio/ETHERNET/ethernet_lib.h
+++ b/radio/ETHERNET/ethernet_lib.h
@@ -9,14 +9,33 @@
 #define ETHERNET_LIB_H
 
 #include <arpa/inet.h>
+#ifdef __linux__
 #include <linux/if_packet.h>
+#else
+/* AF_PACKET is Linux. The raw Ethernet transport (eth_raw.c) is not built
+ * elsewhere; the address field below only has to exist for the state
+ * structure to be laid out. */
+struct sockaddr_ll {
+  unsigned short sll_family;
+  unsigned short sll_protocol;
+  int sll_ifindex;
+  unsigned short sll_hatype;
+  unsigned char sll_pkttype;
+  unsigned char sll_halen;
+  unsigned char sll_addr[8];
+};
+#endif
 #include <stdio.h>
 #include <string.h>
 #include <stdlib.h>
 #include <sys/ioctl.h>
 #include <sys/socket.h>
 #include <net/if.h>
+#ifdef __APPLE__
+#include <net/ethernet.h> /* struct ether_header, ether_aton() */
+#else
 #include <netinet/ether.h>
+#endif
 #include "common/utils/threadPool/notified_fifo.h"
 
 #define MAX_INST 4
