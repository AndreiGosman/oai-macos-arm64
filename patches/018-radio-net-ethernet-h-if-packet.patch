 #ifndef __ETHERNET_USERSPACE_LIB_IF_DEFS__H__
 #define __ETHERNET_USERSPACE_LIB_IF_DEFS__H__
 
+#ifdef __APPLE__
+#include <net/ethernet.h> /* struct ether_header, ether_aton() */
+#else
 #include <netinet/ether.h>
+#endif
 #include <stdint.h>
 
 #ifndef LITE_COMPILATION
