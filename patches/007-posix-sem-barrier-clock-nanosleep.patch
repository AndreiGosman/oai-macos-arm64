diff --git a/common/utils/darwin_compat.h b/common/utils/darwin_compat.h
new file mode 100644
index 0000000..a97f7d2
--- /dev/null
+++ b/common/utils/darwin_compat.h
@@ -0,0 +1,108 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/* POSIX interfaces that Darwin does not provide: pthread barriers and
+ * clock_nanosleep(). Empty on every other platform. */
+
+#ifndef OAI_DARWIN_COMPAT_H
+#define OAI_DARWIN_COMPAT_H
+
+#ifdef __APPLE__
+
+#include <errno.h>
+#include <pthread.h>
+#include <time.h>
+
+/* pthread_barrier_* over a mutex, a condition variable and a generation
+ * counter, with the POSIX return values. */
+
+typedef struct {
+  int unused;
+} pthread_barrierattr_t;
+
+typedef struct {
+  pthread_mutex_t mutex;
+  pthread_cond_t cond;
+  unsigned int count;
+  unsigned int waiting;
+  unsigned int generation;
+} pthread_barrier_t;
+
+#define PTHREAD_BARRIER_SERIAL_THREAD (-1)
+
+static inline int pthread_barrier_init(pthread_barrier_t *b, const pthread_barrierattr_t *attr, unsigned int count)
+{
+  (void)attr;
+  if (count == 0)
+    return EINVAL;
+  b->count = count;
+  b->waiting = 0;
+  b->generation = 0;
+  int ret = pthread_mutex_init(&b->mutex, NULL);
+  if (ret != 0)
+    return ret;
+  ret = pthread_cond_init(&b->cond, NULL);
+  if (ret != 0)
+    pthread_mutex_destroy(&b->mutex);
+  return ret;
+}
+
+static inline int pthread_barrier_wait(pthread_barrier_t *b)
+{
+  pthread_mutex_lock(&b->mutex);
+  unsigned int generation = b->generation;
+  if (++b->waiting == b->count) {
+    b->waiting = 0;
+    b->generation++;
+    pthread_cond_broadcast(&b->cond);
+    pthread_mutex_unlock(&b->mutex);
+    return PTHREAD_BARRIER_SERIAL_THREAD;
+  }
+  while (generation == b->generation)
+    pthread_cond_wait(&b->cond, &b->mutex);
+  pthread_mutex_unlock(&b->mutex);
+  return 0;
+}
+
+static inline int pthread_barrier_destroy(pthread_barrier_t *b)
+{
+  int ret = pthread_cond_destroy(&b->cond);
+  int ret2 = pthread_mutex_destroy(&b->mutex);
+  return ret != 0 ? ret : ret2;
+}
+
+/* clock_nanosleep() with TIMER_ABSTIME. Darwin only has nanosleep(), which
+ * takes a relative interval: convert against the requested clock. Returns
+ * the error number like the Linux call, so a caller that retries on EINTR
+ * recomputes the interval from the same deadline. */
+
+#ifndef TIMER_ABSTIME
+#define TIMER_ABSTIME 1
+#endif
+
+static inline int clock_nanosleep(clockid_t clock_id, int flags, const struct timespec *req, struct timespec *rem)
+{
+  struct timespec delta = *req;
+  if (flags & TIMER_ABSTIME) {
+    struct timespec now;
+    if (clock_gettime(clock_id, &now) != 0)
+      return errno;
+    delta.tv_sec = req->tv_sec - now.tv_sec;
+    delta.tv_nsec = req->tv_nsec - now.tv_nsec;
+    if (delta.tv_nsec < 0) {
+      delta.tv_nsec += 1000000000L;
+      delta.tv_sec--;
+    }
+    if (delta.tv_sec < 0)
+      return 0;
+    rem = NULL;
+  }
+  if (nanosleep(&delta, rem) != 0)
+    return errno;
+  return 0;
+}
+
+#endif /* __APPLE__ */
+
+#endif /* OAI_DARWIN_COMPAT_H */
diff --git a/common/utils/oai_sem.h b/common/utils/oai_sem.h
new file mode 100644
index 0000000..b0b02b9
--- /dev/null
+++ b/common/utils/oai_sem.h
@@ -0,0 +1,92 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/* Counting semaphore. POSIX sem_t where sem_init() works; Darwin declares
+ * sem_init() but returns ENOSYS, so it uses a mutex and a condition variable. */
+
+#ifndef OAI_SEM_H
+#define OAI_SEM_H
+
+#ifdef __APPLE__
+
+/* Darwin declares sem_init() but returns ENOSYS. A counting semaphore over
+ * a mutex and a condition variable; libdispatch would do, but its headers
+ * bring the Mach time_value_t into every holder of this header, which
+ * clashes with the time_value_t of common/utils/time_stat.h. */
+
+#include <pthread.h>
+
+typedef struct {
+  pthread_mutex_t mutex;
+  pthread_cond_t cond;
+  unsigned int count;
+} oai_sem_t;
+
+static inline int oai_sem_init(oai_sem_t *s, unsigned int value)
+{
+  s->count = value;
+  int ret = pthread_mutex_init(&s->mutex, NULL);
+  if (ret != 0)
+    return ret;
+  ret = pthread_cond_init(&s->cond, NULL);
+  if (ret != 0)
+    pthread_mutex_destroy(&s->mutex);
+  return ret;
+}
+
+static inline int oai_sem_post(oai_sem_t *s)
+{
+  pthread_mutex_lock(&s->mutex);
+  s->count++;
+  pthread_cond_signal(&s->cond);
+  pthread_mutex_unlock(&s->mutex);
+  return 0;
+}
+
+static inline int oai_sem_wait(oai_sem_t *s)
+{
+  pthread_mutex_lock(&s->mutex);
+  while (s->count == 0)
+    pthread_cond_wait(&s->cond, &s->mutex);
+  s->count--;
+  pthread_mutex_unlock(&s->mutex);
+  return 0;
+}
+
+static inline int oai_sem_destroy(oai_sem_t *s)
+{
+  int ret = pthread_cond_destroy(&s->cond);
+  int ret2 = pthread_mutex_destroy(&s->mutex);
+  return ret != 0 ? ret : ret2;
+}
+
+#else /* POSIX */
+
+#include <semaphore.h>
+
+typedef sem_t oai_sem_t;
+
+static inline int oai_sem_init(oai_sem_t *s, unsigned int value)
+{
+  return sem_init(s, 0, value);
+}
+
+static inline int oai_sem_post(oai_sem_t *s)
+{
+  return sem_post(s);
+}
+
+static inline int oai_sem_wait(oai_sem_t *s)
+{
+  return sem_wait(s);
+}
+
+static inline int oai_sem_destroy(oai_sem_t *s)
+{
+  return sem_destroy(s);
+}
+
+#endif
+
+#endif /* OAI_SEM_H */
