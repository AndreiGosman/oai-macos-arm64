-    int ret = sem_wait(&sem);                                                                  \
+    int ret = oai_sem_wait(&sem);                                                                  \
     AssertFatal(ret == 0, "sem_wait(): ret=%d, errno=%d (%s)\n", ret, errno, strerror(errno)); \
   }
 #define semdestroy(sem)                                                                           \
   {                                                                                               \
-    int ret = sem_destroy(&sem);                                                                  \
