diff --git a/common/utils/utils.h b/common/utils/utils.h
index f984f4f..cd78210 100644
--- a/common/utils/utils.h
+++ b/common/utils/utils.h
@@ -13,8 +13,18 @@ extern "C" {
 #include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
-#include <malloc.h>
 #include <sys/types.h>
+#ifdef __APPLE__
+/* Darwin has no <malloc.h> and no memalign(); posix_memalign() is the
+ * portable spelling of the same allocation. */
+static inline void *memalign(size_t alignment, size_t size)
+{
+  void *ptr = NULL;
+  return posix_memalign(&ptr, alignment, size) == 0 ? ptr : NULL;
+}
+#else
+#include <malloc.h>
+#endif
 #include <common/utils/assertions.h>
 
 #ifdef MALLOC_TRACE
