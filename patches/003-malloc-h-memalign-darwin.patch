 common/utils/threadPool/notified_fifo.h              |  3 ++-
 common/utils/threadPool/thread-pool.h                |  2 +-
 common/utils/utils.h                                 | 12 +++++++++++-
 nfapi/open-nFAPI/fapi/src/nr_fapi_p7_utils.c         |  2 +-
 .../nrLDPC_coding/nrLDPC_coding_interface_load.c     |  2 +-
 openair1/PHY/CODING/nrLDPC_load.c                    |  2 +-
