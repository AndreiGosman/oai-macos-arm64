 CMakeLists.txt                 | 85 +++++++++++++++++++++-------------
 common/utils/T/CMakeLists.txt  |  4 +-
 tests/nrdlbench/CMakeLists.txt |  2 +-
 3 files changed, 57 insertions(+), 34 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ee0b1c6..c19268e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -237,6 +237,27 @@ else ()
   set(C_FLAGS_PROCESSOR "${C_FLAGS_PROCESSOR} -march=armv8.2-a")
 endif()
 
+# Darwin: ld64 is not GNU ld. It has no --start-group/--end-group (it
+# re-scans static archives on its own, so the groups are not needed), no
+# --whole-archive (-force_load takes one archive path instead), and there is
+# no librt or libgcc to link: the clock_* family and the other librt symbols
+# live in libSystem. The processor branches above also put -lgcc -lrt into
+# the compiler flags, which ld64 rejects at link time.
+if(APPLE)
+  string(REPLACE " -lgcc -lrt" "" C_FLAGS_PROCESSOR "${C_FLAGS_PROCESSOR}")
+  set(LINK_GROUP_START "")
+  set(LINK_GROUP_END "")
+  set(OAI_LIBRT "")
+  # crc_byte is an OBJECT library: its objects go on the link line as they
+  # are, so no whole-archive treatment is needed (or possible) for it.
+  set(CRC_BYTE_WHOLE_ARCHIVE crc_byte)
+else()
+  set(LINK_GROUP_START ${LINK_GROUP_START})
+  set(LINK_GROUP_END ${LINK_GROUP_END})
+  set(OAI_LIBRT rt)
+  set(CRC_BYTE_WHOLE_ARCHIVE -Wl,--whole-archive crc_byte -Wl,--no-whole-archive)
+endif()
+
 # we need -rdynamic to incorporate all symbols in shared objects, see man page
 set(commonOpts "-pipe -fPIC -Wall -fno-strict-aliasing -rdynamic")
 # GNU C/C++ Compiler might throw many warnings without packed-bitfield-compat, see man page
@@ -245,7 +266,7 @@ if(CMAKE_C_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
 endif()
 # clang: suppress complaints about unused command line argument (-rdynamic only
 # used during linking) and "const member leaves the object uninitialized"
-if(CMAKE_C_COMPILER_ID STREQUAL "Clang" OR CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
+if(CMAKE_C_COMPILER_ID MATCHES "Clang" OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
   set(commonOpts "${commonOpts} -Wno-unused-command-line-argument -Wno-default-const-init-field-unsafe")
 endif()
 
