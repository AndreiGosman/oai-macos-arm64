From 473a584602565880a599814fd4ba60824780006e Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Fri, 2 Oct 2026 12:48:21 +0300
Subject: [PATCH] build: treat CMAKE_SYSTEM_PROCESSOR arm64 as aarch64

Darwin reports the 64-bit ARM processor as "arm64" where Linux reports
"aarch64". The top-level CMakeLists.txt selects the processor flags with
an exact string compare and stops with FATAL_ERROR for any value that is
not x86_64, armv7l or aarch64, so an arm64 host cannot even configure:

  CMake Error at CMakeLists.txt:213 (message):
    compile for CPU architecture , CMAKE_SYSTEM_PROCESSOR arm64

The CUDA block at the top of the file tests the same string.

Map arm64 to aarch64 once, right after project(), so that every test in
this file and in the subdirectories sees the same processor string. On an
arm64 host without /proc/cpuinfo the aarch64 branch then falls through to
-mcpu=native, which Apple clang resolves to the host core.
---
 CMakeLists.txt | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index fd78f5c..ee0b1c6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2,6 +2,16 @@
 
 cmake_minimum_required (VERSION 3.19)
 project (OpenAirInterface LANGUAGES C CXX)
+
+# Darwin reports the 64-bit ARM processor as "arm64" where Linux reports
+# "aarch64". The architecture selection below tests the exact string
+# "aarch64" and stops with FATAL_ERROR on anything else, and the CUDA block
+# below does the same. Normalise once, right after project(), so that every
+# test in this file and in the subdirectories sees the same string.
+if (CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64")
+  set(CMAKE_SYSTEM_PROCESSOR "aarch64")
+endif()
+
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(OAI_VERSION 2.4.0)
-- 
2.55.0

