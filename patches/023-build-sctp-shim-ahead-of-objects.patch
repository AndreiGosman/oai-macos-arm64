From 7c932f632a63d7d9d16d693c5cbfb23b29e4067c Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Fri, 2 Oct 2026 15:57:03 +0300
Subject: [PATCH] build: name the SCTP shim ahead of the objects on Darwin
 executables

libsctp-compat, the SCTP library of this port, interposes socket(),
bind(), connect(), setsockopt() and the other BSD calls for the
descriptors it owns. ld64 binds each undefined symbol to the first
library on the link line that exports it (two-level namespace), and the
shim came after the objects, so every executable bound those calls to
libSystem; the kernel then refused the SCTP socket:

  [SCTP] Socket creation failed: Protocol not supported

Add the shim to CMAKE_EXE_LINKER_FLAGS on APPLE, which puts it ahead of
the objects on every executable link line. After this the gNB opens its
NGAP socket through the shim and completes NG Setup with the AMF.
---
 CMakeLists.txt | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4fb7833..9c29d83 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1437,6 +1437,15 @@ target_link_libraries(MME_APP PRIVATE asn1_nr_rrc_hdrs asn1_lte_rrc_hdrs)
 target_link_libraries(MME_APP PRIVATE nfapi_lte_user_lib)
 
 find_package(sctp REQUIRED)
+if(APPLE)
+  # libsctp-compat interposes socket(), bind(), connect(), setsockopt() and
+  # the rest for the descriptors it owns. With the two-level namespace of
+  # ld64 each undefined symbol is bound to the first library on the link
+  # line that exports it, and the shim comes after the objects, so the calls
+  # went to libSystem and SCTP sockets were refused by the kernel. Name the
+  # shim ahead of the objects on every executable's link line.
+  set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} ${sctp_LIBRARY}")
+endif()
 set(SCTP_SRC
   ${OPENAIR3_DIR}/SCTP/sctp_common.c
   ${OPENAIR3_DIR}/SCTP/sctp_eNB_task.c
