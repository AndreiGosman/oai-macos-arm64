 #include <errno.h>
 #include <fcntl.h>
-#include <error.h>
 #include <time.h>
 #include <unistd.h>
 
diff --git a/common/utils/darwin_compat.h b/common/utils/darwin_compat.h
index a97f7d2..92aa8a8 100644
--- a/common/utils/darwin_compat.h
+++ b/common/utils/darwin_compat.h
@@ -13,6 +13,7 @@
 #include <errno.h>
 #include <pthread.h>
 #include <time.h>
+#include <unistd.h>
 
 /* pthread_barrier_* over a mutex, a condition variable and a generation
  * counter, with the POSIX return values. */
@@ -103,6 +104,23 @@ static inline int clock_nanosleep(clockid_t clock_id, int flags, const struct ti
   return 0;
 }
 
+/* get_nprocs() from glibc <sys/sysinfo.h>. */
+static inline int get_nprocs(void)
+{
+  return (int)sysconf(_SC_NPROCESSORS_ONLN);
+}
+
+/* pthread_setname_np(): Darwin names only the calling thread and takes the
+ * name alone. Accept the two-argument form for the calling thread and
+ * report ENOTSUP for any other thread. */
+static inline int oai_pthread_setname_np(pthread_t thread, const char *name)
+{
+  if (pthread_equal(thread, pthread_self()))
+    return pthread_setname_np(name);
+  return ENOTSUP;
+}
+#define pthread_setname_np(thread, name) oai_pthread_setname_np((thread), (name))
+
 #endif /* __APPLE__ */
 
 #endif /* OAI_DARWIN_COMPAT_H */
diff --git a/common/utils/system.c b/common/utils/system.c
index af07288..d10a632 100644
--- a/common/utils/system.c
+++ b/common/utils/system.c
@@ -214,7 +214,7 @@ bool has_cap_sys_nice(void)
   /* return true if CAP_SYS_NICE is currently set */
   return val == CAP_SET;
 }
-#else
+#elif defined(__linux__)
 /* libcap has not been detected on this system. We do not need to require it --
  * we can try to read directly via a syscall. This is discouraged, though; from
  * the man page: "The portable interfaces are cap_set_proc(3) and
@@ -231,6 +231,13 @@ bool has_cap_sys_nice(void)
     return false;
   return (cap[0].effective & (1 << CAP_SYS_NICE)) != 0;
 }
+#else
+/* No capability interface on this platform: never raise priorities or pin
+ * threads, the same behaviour as an unprivileged Linux process. */
+bool has_cap_sys_nice(void)
+{
+  return false;
+}
 #endif
 
 void threadCreate(pthread_t* t, void * (*func)(void*), void * param, char* name, int affinity, int priority)
@@ -264,6 +271,7 @@ void threadCreate(pthread_t* t, void * (*func)(void*), void * param, char* name,
     LOG_I(UTIL, "%s() for %s: creating thread (no affinity, default priority)\n", __func__, name);
   }
 
+#ifdef __linux__
   if (affinity != -1) {
     cpu_set_t cpuset;
     CPU_ZERO(&cpuset);
@@ -272,6 +280,10 @@ void threadCreate(pthread_t* t, void * (*func)(void*), void * param, char* name,
     ret = pthread_attr_setaffinity_np(&attr, sizeof(cpu_set_t), &cpuset);
     AssertFatal(ret == 0, "Error in pthread_attr_setaffinity_np(): ret: %d, errno: %d\n", ret, errno);
   }
+#else
+  if (affinity != -1)
+    LOG_W(UTIL, "%s() for %s: CPU affinity is not supported on this platform, thread not pinned\n", __func__, name);
+#endif
 
   ret=pthread_create(t, &attr, func, param);
   AssertFatal(ret == 0, "Error in pthread_create(): ret: %d, errno: %d\n", ret, errno);
@@ -279,7 +291,12 @@ void threadCreate(pthread_t* t, void * (*func)(void*), void * param, char* name,
   char short_name[16];
   strncpy(short_name, name, sizeof(short_name) - 1);
   short_name[sizeof(short_name) - 1] = '\0';
+#ifdef __APPLE__
+  /* Darwin can only name the calling thread; the name is not applied. */
+  ret = 0;
+#else
   ret = pthread_setname_np(*t, short_name);
+#endif
   // pthread_create() can initialize and complete before setting a name
   AssertFatal(ret == 0 || ret == ENOENT || ret == ESRCH, "Error in pthread_setname_np(): ret: %d, errno: %d\n", ret, errno);
   if (ret != 0) {
@@ -301,8 +318,12 @@ void thread_top_init(char *thread_name)
   int policy, s, j;
   struct sched_param sparam;
   char cpu_affinity[1024];
-  cpu_set_t cpuset;
   int settingPriority = 1;
+  int cpu = -1;
+
+  memset(cpu_affinity,0,sizeof(cpu_affinity));
+#ifdef __linux__
+  cpu_set_t cpuset;
 
   /* Set affinity mask to include CPUs 2 to MAX_CPUS */
   /* CPU 0 is reserved for UHD threads */
@@ -317,7 +338,6 @@ void thread_top_init(char *thread_name)
     perror( "pthread_getaffinity_np");
     exit_fun("Error getting processor affinity ");
   }
-  memset(cpu_affinity,0,sizeof(cpu_affinity));
   for (j = 0; j < 1024; j++)
   {
     if (CPU_ISSET(j, &cpuset))
@@ -327,6 +347,10 @@ void thread_top_init(char *thread_name)
       strcat(cpu_affinity, temp);
     }
   }
+  cpu = sched_getcpu();
+#else
+  (void)j;
+#endif
 
   if (settingPriority) {
     memset(&sparam, 0, sizeof(sparam));
@@ -347,7 +371,7 @@ void thread_top_init(char *thread_name)
 
     pthread_setname_np(pthread_self(), thread_name);
 
-    LOG_I(HW, "[SCHED][eNB] %s started on CPU %d, sched_policy = %s , priority = %d, CPU Affinity=%s \n",thread_name,sched_getcpu(),
+    LOG_I(HW, "[SCHED][eNB] %s started on CPU %d, sched_policy = %s , priority = %d, CPU Affinity=%s \n",thread_name,cpu,
                      (policy == SCHED_FIFO)  ? "SCHED_FIFO" :
                      (policy == SCHED_RR)    ? "SCHED_RR" :
                      (policy == SCHED_OTHER) ? "SCHED_OTHER" :
