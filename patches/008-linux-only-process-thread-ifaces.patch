diff --git a/common/utils/tuntap_if.c b/common/utils/tuntap_if.c
index 0b9d03b..17729f5 100644
--- a/common/utils/tuntap_if.c
+++ b/common/utils/tuntap_if.c
@@ -10,8 +10,10 @@
 #include <net/if.h>
 #include <netinet/in.h>
 #include <arpa/inet.h>
+#ifdef __linux__
 #include <linux/ipv6.h>
 #include <linux/netlink.h>
+#endif
 
 #include "tuntap_if.h"
 #include "common/platform_constants.h"
@@ -21,6 +23,8 @@
 int nas_sock_fd[MAX_MOBILES_PER_ENB * 2]; // Allocated for both LTE UE and NR UE.
 int nas_sock_mbms_fd;
 
+#ifdef __linux__
+
 int tuntap_alloc(int flag, const char *dev)
 {
   struct ifreq ifr;
@@ -301,6 +305,73 @@ void setup_ue_ipv4_route(const char* ifname, int instance_id, int pdu_session_id
   background_system(command_line);
 }
 
+#else /* not __linux__ */
+
+/* The implementation above is written on the Linux tun driver, ioctl(2)
+ * interface configuration and ip(8) rules. Only the UE reaches these
+ * functions; the gNB never opens a tunnel. Darwin has utun instead, which
+ * is not implemented here: every call reports failure. */
+
+static int tuntap_unsupported(const char *func, const char *ifname)
+{
+  LOG_E(UTIL, "%s(%s): TUN/TAP interfaces are not implemented on this platform\n", func, ifname ? ifname : "");
+  return -1;
+}
+
+int tuntap_alloc(int flag, const char *dev)
+{
+  (void)flag;
+  return tuntap_unsupported(__func__, dev);
+}
+
+void tuntap_reblock(int fd)
+{
+  (void)fd;
+}
+
+int tun_init_mbms(char *ifname)
+{
+  tuntap_unsupported(__func__, ifname);
+  return 0;
+}
+
+int tun_init(const char *ifname, int instance_id)
+{
+  (void)instance_id;
+  tuntap_unsupported(__func__, ifname);
+  return 0;
+}
+
+short tuntap_set_up(const char *ifname, int sock_fd)
+{
+  (void)sock_fd;
+  return (short)tuntap_unsupported(__func__, ifname);
+}
+
+bool tun_config(const char* ifname, const char *ipv4, const char *ipv6)
+{
+  (void)ipv4;
+  (void)ipv6;
+  tuntap_unsupported(__func__, ifname);
+  return false;
+}
+
+bool tap_config(const char* ifname)
+{
+  tuntap_unsupported(__func__, ifname);
+  return false;
+}
+
+void setup_ue_ipv4_route(const char* ifname, int instance_id, int pdu_session_id, const char *ipv4)
+{
+  (void)instance_id;
+  (void)pdu_session_id;
+  (void)ipv4;
+  tuntap_unsupported(__func__, ifname);
+}
+
+#endif /* __linux__ */
+
 int tun_generate_ifname(char *ifname, const char *ifprefix, int instance_id)
 {
   return snprintf(ifname, IFNAMSIZ, "%s%d", ifprefix, instance_id + 1);
@@ -316,6 +387,7 @@ int tuntap_generate_ue_ifname(char *ifname, int flag, int instance_id, int pdu_s
   return snprintf(ifname, IFNAMSIZ, "%s%d%s", basename, instance_id + 1, pdu_session_id == -1 ? "" : pdu_session_string);
 }
 
+#ifdef __linux__
 void tuntap_destroy(const char *dev)
 {
   // Use a new socket for ioctl operations
@@ -334,3 +406,9 @@ void tuntap_destroy(const char *dev)
   } // no else: get_if_flags()/set_if_flags() should have printed error
   close(fd);
 }
+#else
+void tuntap_destroy(const char *dev)
+{
+  tuntap_unsupported(__func__, dev);
+}
+#endif /* __linux__ */
