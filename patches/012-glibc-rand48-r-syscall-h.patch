diff --git a/openair1/SIMULATION/TOOLS/taus.c b/openair1/SIMULATION/TOOLS/taus.c
index 6bcbad7..789a2af 100644
--- a/openair1/SIMULATION/TOOLS/taus.c
+++ b/openair1/SIMULATION/TOOLS/taus.c
@@ -28,22 +28,19 @@ unsigned int taus(void)
 void set_taus_seed(unsigned int seed_init)
 {
 
-  struct drand48_data buffer;
-  unsigned long result = 0;
-
   if (seed_init == 0) {
     fill_random(&s0, sizeof(s0));
     fill_random(&s1, sizeof(s1));
     fill_random(&s2, sizeof(s2));
   } else {
-    /* Use reentrant version of rand48 to ensure that no conflicts with other generators occur */
-    srand48_r((long int)seed_init, &buffer);
-    mrand48_r(&buffer, (long int *)&result);
-    s0 = result;
-    mrand48_r(&buffer, (long int *)&result);
-    s1 = result;
-    mrand48_r(&buffer, (long int *)&result);
-    s2 = result;
+    /* rand48 with its own state, so that no conflicts with other generators
+     * occur. jrand48() over this state gives the sequence that srand48_r()
+     * and mrand48_r() gave: srand48() seeds the 48-bit state with 0x330E in
+     * the low word and the 32-bit seed above it. */
+    unsigned short xsubi[3] = {0x330E, (unsigned short)seed_init, (unsigned short)(seed_init >> 16)};
+    s0 = (unsigned int)jrand48(xsubi);
+    s1 = (unsigned int)jrand48(xsubi);
+    s2 = (unsigned int)jrand48(xsubi);
   }
 }
 
