 common/utils/tuntap_if.h                 |  27 +++
 openair2/LAYER2/PDCP_v10.1.0/pdcp_fifo.c |   5 +-
 openair2/SDAP/nr_sdap/nr_sdap.c          |   2 +-
 openair2/SDAP/nr_sdap/nr_sdap_entity.c   |   2 +-
 5 files changed, 224 insertions(+), 35 deletions(-)

