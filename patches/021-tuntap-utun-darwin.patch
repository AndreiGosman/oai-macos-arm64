       if( LOG_DEBUGFLAG(DEBUG_PDCP) ) 
 	log_dump(PDCP, pdcpData, pdcpHead->data_size, LOG_DUMP_CHAR,"PDCP output to be sent to TUN interface: \n");
-      ret = write(nas_sock_fd[0], pdcpData, pdcpHead->data_size);
